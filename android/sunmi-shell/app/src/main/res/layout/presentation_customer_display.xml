<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#0B0B10"
  android:orientation="vertical"
  android:padding="24dp">

  <TextView
    android:id="@+id/customer_display_brand"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:textColor="#F8FAFC"
    android:textSize="28sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/customer_display_subtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center"
    android:text="@string/customer_display_subtitle"
    android:textColor="#A1A1AA"
    android:textSize="16sp" />

  <TextView
    android:id="@+id/customer_display_empty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="32dp"
    android:layout_weight="1"
    android:gravity="center"
    android:text="@string/customer_display_empty"
    android:textColor="#71717A"
    android:textSize="22sp"
    android:visibility="gone" />

  <ScrollView
    android:id="@+id/customer_display_scroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="24dp"
    android:layout_weight="1"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
      android:id="@+id/customer_display_lines"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />
  </ScrollView>

  <LinearLayout
    android:id="@+id/customer_display_total_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:background="#18181B"
    android:orientation="horizontal"
    android:padding="20dp"
    android:visibility="gone">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/customer_display_total"
      android:textColor="#E4E4E7"
      android:textSize="24sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/customer_display_total"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#FDE68A"
      android:textSize="28sp"
      android:textStyle="bold" />
  </LinearLayout>

</LinearLayout>